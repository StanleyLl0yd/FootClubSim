{
  "name": "footclubsim",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "FootClubSim M0 browser shell and isolated headless football domain",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.app.json",
    "build:core": "tsc",
    "build:web": "vite build",
    "test": "npm run build:core && node --test tests/*.test.mjs",
    "diagnose:m1": "npm run build:core && node scripts/m1-diagnostics.mjs",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run build:web",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "format:check": "node scripts/check-source-format.mjs"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "5.8.3",
    "vite": "8.3.4",
    "eslint": "9.39.1",
    "typescript-eslint": "8.71.1",
    "eslint-plugin-react-hooks": "7.1.1"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  }
}
